# Utilazy Local Environment Configuration

# App Config
APP_NAME=Utilazy
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SECRET=secure_app_secret_abc123xyz
SESSION_SECRET=secure_session_secret_xyz123abc
ENCRYPTION_KEY=super_secret_encryption_key_32_bytes_long

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=utilazy
DB_USER=root
DB_PASS=

# Cloudflare Turnstile Configuration
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000

# Social Logins (Google & Apple)
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

APPLE_CLIENT_ID=mock_apple_client_id
APPLE_TEAM_ID=mock_apple_team_id
APPLE_KEY_ID=mock_apple_key_id
APPLE_REDIRECT_URI=http://localhost:8000/auth/apple/callback

# Lemon Squeezy Payments Configuration
LEMON_STORE_ID=12345
LEMON_API_KEY=mock_api_key
LEMON_WEBHOOK_SECRET=mock_signing_secret

# Mailer Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMTP_FROM_EMAIL=noreply@utilazy.com
SMTP_FROM_NAME=Utilazy Support

# Upload Limits
MAX_UPLOAD_SIZE=10485760